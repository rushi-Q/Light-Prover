# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 120

[*.{sh,bash}]
indent_size = 2

[*.lean]
indent_size = 2

[*.rs]
indent_size = 4

[*.{json,yml,yaml,toml,cff}]
indent_size = 2

[*.md]
# a trailing double space is a line break in Markdown
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

# data, patches and recorded outputs must stay byte-for-byte as they are
[*.{export,ndjson,tsv,patch,diff,log}]
indent_style = unset
trim_trailing_whitespace = false
insert_final_newline = unset

# third-party trees keep their upstream formatting
[{sources/**,fastverify/check/notary/gruszka-src/**}]
indent_style = unset
indent_size = unset
max_line_length = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
