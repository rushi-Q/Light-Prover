#!/bin/sh
# cadical is built with `c++` (= g++ 13, PIE by default, in the original Ubuntu 24.04 build); here gcc-toolset-13 g++ 13.3.1,
# PIE like Ubuntu's default, libstdc++/libgcc static, unreferenced sections dropped (so libstdc++'s random_device/getentropy
# objects pulled in by the locale code do not stay referenced), glibc-2.17 libm for linking only.
exec /opt/rh/gcc-toolset-13/root/usr/bin/g++ -fPIE -pie "$@" -static-libstdc++ -static-libgcc -Wl,--gc-sections -L/opt/glibc217/lib
