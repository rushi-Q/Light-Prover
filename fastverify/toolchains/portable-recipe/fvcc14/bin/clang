#!/bin/sh
# portable rebuild of lean4-7586a50cec-nopgo (originally Ubuntu clang 14.0.0 + lld 14 + gcc-12 libstdc++ on Ubuntu 22.04,
# PIE by default): clang 14.0.6 (conda-forge clangdev 14.0.6 default_h7634d5b_1) against the manylinux_2_28 root +
# gcc-toolset-12 (12.2.1); glibc-2.17 libm at link time only (see fvcc/bin/clang).
# clang 14 environment (mkenv.sh): $FVCC_CENV14, default $PORT_WORK/cenv14.
L=-L/opt/glibc217/lib
for a in "$@"; do case "$a" in -c|-S|-E|-M|-MM) L=;; esac; done
D=$(date -u -d @${SOURCE_DATE_EPOCH:-0} "+%b %e %Y"); T=$(date -u -d @${SOURCE_DATE_EPOCH:-0} +%H:%M:%S)
exec "${FVCC_CENV14:-${PORT_WORK:?work root of the portable-toolchain recipe, or set FVCC_CENV14 (required)}/cenv14}/bin/clang-14" -Wno-builtin-macro-redefined "-D__DATE__=\"$D\"" "-D__TIME__=\"$T\"" -fPIE -pie --target=x86_64-pc-linux-gnu --sysroot=/ --gcc-toolchain=/opt/rh/gcc-toolset-12/root/usr $L "$@"
