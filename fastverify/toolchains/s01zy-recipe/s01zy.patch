+    uintptr_t b = reinterpret_cast<uintptr_t>(base), e = b + size;
+    if (b % 4096 != 0 || e < b) return false;
+    uintptr_t lo = b & ~(H - 1), hi = (e + H - 1) & ~(H - 1);
+    bool touches = false;
+    for (uintptr_t w = lo; w < hi; w += H)
+        if (g_olean_thp_windows->count(w)) { touches = true; break; }
+    if (size < min_bytes && !touches) return false;
