index 07880f0..603ad4b 100644
--- a/PChk/Incr.lean
+++ b/PChk/Incr.lean
@@ -327,4 +327,232 @@ def finalCheck (env : Kernel.Environment) (m : Std.HashMap Name ConstantInfo) (n
