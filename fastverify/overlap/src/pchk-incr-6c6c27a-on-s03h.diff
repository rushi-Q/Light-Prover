+    let h ← IO.FS.Handle.mk (d / "cmd") .readWrite
+    h.putStr s!"final {exportFile} {nonce}\n"
+    h.flush
+  catch e => return ← fallback s!"cannot send the request ({e})"
+  let res := d / s!"res-{nonce}"
