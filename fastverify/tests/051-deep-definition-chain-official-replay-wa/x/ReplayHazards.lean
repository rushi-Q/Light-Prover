import Lean
import LeanExport.Parse
open Lean

/-! ReplayHazards (based on the ReplayOrder.lean O1 checker; adds the official walk's recursion DEPTH, finding 051).
O1 risk checker: simulates Lean 4.36 `leanchecker --from-export` (LeanChecker.checkExport + Lean/Replay.lean)
order of adding constants, WITHOUT the kernel, and reports every declaration that would be sent to the kernel while
a constant the kernel may need IMPLICITLY is not yet in the environment:
  * Quot.mk / Quot.lift / Quot.ind (erased from the replay map; they appear only once `Quot` is replayed)
  * String.ofList / Char.ofNat (string literal expansion) for declarations containing a string literal
  * Nat (type of nat literals) for declarations containing a nat literal
A report is a POTENTIAL false reject (the kernel needs the constant only if it reduces/infers there); zero reports =
the export is safe from this order-dependence. -/

structure St where
  remaining : NameSet
  pending : NameSet := {}
  added : NameSet := {}
  nAdded : Nat := 0
  issues : Array String := #[]
  depth : Nat := 0
  maxDepth : Nat := 0
  maxAt : Name := .anonymous

abbrev M := ReaderT (Std.HashMap Name ConstantInfo) (StateT St IO)

def isTodo (n : Name) : M Bool := do
  let s ← get
  if s.remaining.contains n then
    set { s with remaining := s.remaining.erase n, pending := s.pending.insert n }
    return true
  return false

def hasLit (p : Literal → Bool) (e : Expr) : Bool :=
  (e.find? fun x => match x with | .lit l => p l | _ => false).isSome

def litStr : Literal → Bool | .strVal _ => true | _ => false
def litNat : Literal → Bool | .natVal _ => true | _ => false

def exprsOf (ci : ConstantInfo) : List Expr :=
  ci.type :: (match ci.value? (allowOpaque := true) with | some v => [v] | none => [])

def check (what : Name) (es : List Expr) (used : NameSet) : M Unit := do
  let s ← get
  let mut need : Array Name := #[]
  for q in [`Quot.mk, `Quot.lift, `Quot.ind] do
    if used.contains q then need := need.push q
  if es.any (hasLit litStr) then need := need ++ #[`String.ofList, `Char.ofNat]
  if es.any (hasLit litNat) then need := need.push `Nat
  for n in need do
    unless s.added.contains n do
      modify fun s => { s with issues := s.issues.push s!"{what}: needs {n}, not yet added (position {s.nAdded})" }

def add (ns : List Name) : M Unit :=
  modify fun s => { s with added := ns.foldl (·.insert ·) s.added, nAdded := s.nAdded + 1 }

mutual
partial def replayConstant (name : Name) : M Unit := do
  if ← isTodo name then
    let some ci := (← read)[name]? | return
    modify fun s => if s.depth + 1 > s.maxDepth then { s with depth := s.depth + 1, maxDepth := s.depth + 1, maxAt := name } else { s with depth := s.depth + 1 }
    replayConstants ci.getUsedConstantsAsSet
    if (← get).pending.contains name then
      match ci with
      | .defnInfo _ | .thmInfo _ | .axiomInfo _ | .opaqueInfo _ =>
        check name (exprsOf ci) ci.getUsedConstantsAsSet; add [name]
      | .inductInfo info =>
        let m ← read
        let all := info.all.filterMap (m[·]?)
        for o in all do
          modify fun s => { s with remaining := s.remaining.erase o.name, pending := s.pending.erase o.name }
        let mut names : List Name := []
        let mut es : List Expr := []
        let mut used : NameSet := {}
        for o in all do
          names := o.name :: names; es := o.type :: es
          if let .inductInfo iv := o then
            for c in iv.ctors do
              if let some cc := m[c]? then
                replayConstants cc.getUsedConstantsAsSet
                names := c :: names; es := cc.type :: es
                for u in cc.getUsedConstantsAsSet do used := used.insert u
            -- recursors are generated by the kernel
            names := (o.name ++ `rec) :: names
        check name es used; add names
      | .ctorInfo _ | .recInfo _ => pure ()
      | .quotInfo _ =>
        replayConstant `Eq
        add [`Quot, `Quot.mk, `Quot.lift, `Quot.ind]
      modify fun s => { s with pending := s.pending.erase name }
    modify fun s => { s with depth := s.depth - 1 }

partial def replayConstants (names : NameSet) : M Unit := do
  for n in names do replayConstant n
end

def main (args : List String) : IO UInt32 := do
  let [f] := args | IO.eprintln "usage: LEAN_STACK_SIZE_KB=16000000 lean --run ReplayHazards.lean FILE.ndjson"; return 2
  let exportEnv ← IO.FS.withFile f .read fun h => LeanExport.parseStream (.ofHandle h)
  let m := [`Quot.mk, `Quot.lift, `Quot.ind].foldl (init := exportEnv.constMap) (·.erase ·)
  let mut remaining : NameSet := {}
  for (n, ci) in m.toList do
    if !ci.isUnsafe && !ci.isPartial then remaining := remaining.insert n
  let ((), s) ← (do for n in remaining do replayConstant n : M Unit).run m |>.run { remaining }
  IO.println s!"constants {m.size}, added steps {s.nAdded}, potential implicit-dependency issues {s.issues.size}"
  IO.println s!"  official replay walk: maximal recursion depth {s.maxDepth} (reached at {s.maxAt}); measured capacity of the official leanchecker with its default 1 GiB stack: between 3,727,966 (ok) and 4,197,622 (stack overflow) levels -> {if s.maxDepth ≥ 3700000 then "HAZARD: the official comparator may abort (finding 051)" else "ok"}"
  let quot := s.issues.filter (fun i => (i.splitOn "needs Quot").length > 1)
  let natI := s.issues.filter (fun i => (i.splitOn "needs Nat,").length > 1)
  IO.println s!"  DEFINITE (Quot.* used before Quot is replayed -> 'unknown constant'): {quot.size}"
  for i in quot[0:40] do IO.println s!"    {i}"
  IO.println s!"  potential (Nat literal typed before Nat is replayed): {natI.size}"
  for i in natI[0:10] do IO.println s!"    {i}"
  IO.println s!"  potential (string literal before String.ofList/Char.ofNat; only bites if the literal is REDUCED): {s.issues.size - quot.size - natI.size}"
  for i in (s.issues.filter (fun i => (i.splitOn "needs Quot").length == 1 && (i.splitOn "needs Nat,").length == 1))[0:6] do IO.println s!"    {i}"
  return if quot.isEmpty && s.maxDepth < 3700000 then 0 else 1
