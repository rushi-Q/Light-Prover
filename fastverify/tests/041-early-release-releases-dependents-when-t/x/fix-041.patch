 OFFICIAL_LEAN = CFG.get('OFFICIAL_LEAN') or None
 
 
+_ismod = {}
+def is_module_file(m):
+    """(finding 041): does the module's header start with the `module` keyword (Lean module system)?
+    Comment-aware: skips whitespace, `--` line comments and (nested, multi-line) `/- ... -/` block/doc comments."""
+    if m not in _ismod:
+        r = False
+        try:
+            with open(os.path.join(SRC, mods_global[m]), encoding='utf-8', errors='replace') as f: text = f.read()
+            i, n, depth = 0, len(text), 0
+            while i < n:
+                if depth:
+                    if text.startswith('/-', i): depth += 1; i += 2
+                    elif text.startswith('-/', i): depth -= 1; i += 2
+                    else: i += 1
+                elif text[i].isspace(): i += 1
+                elif text.startswith('/-', i): depth = 1; i += 2
+                elif text.startswith('--', i):
+                    j = text.find('\n', i); i = n if j < 0 else j + 1
+                else:
+                    mm = re.match(r'\S+', text[i:i + 64]); r = bool(mm) and mm.group(0) == 'module'; break
+        except OSError: pass
+        _ismod[m] = r
+    return _ismod[m]
+mods_global = {}
