+// S08 (team S): read a text file as lines (no trailing newline, empty lines dropped); missing file -> die (decline)
+static std::vector<std::string> s08_read_lines(const char* path) {
+    std::vector<std::string> out;
+    FILE* f = fopen(path, "rb");
+    if (!f) die(std::string("cannot open ") + path);
+    std::string cur;
+    char buf[1 << 16];
+    size_t k;
+    while ((k = fread(buf, 1, sizeof buf, f)) > 0) {
+        for (size_t i = 0; i < k; i++) {
+            if (buf[i] == '\n') {
+                if (!cur.empty()) out.push_back(cur);
+                cur.clear();
+            } else {
+                cur.push_back(buf[i]);
+            }
+        }
+    }
+    if (!cur.empty()) out.push_back(cur);
+    fclose(f);
+    return out;
+}
