/-
OleanMergeDiff: check a merged module against its original members (Lean 4.33).
  lean --run OleanMergeDiff.lean MERGED.olean KEPT_MODULE ORIG1.olean MOD1 [ORIG2.olean MOD2 ...]
The merged module (named KEPT_MODULE) must contain exactly the constants of the originals, where private names of
every original module MODi (`_private.MODi.0.x`) are renamed to `_private.KEPT_MODULE.0.x` (in names and inside
types/values); every constant must be equal (Expr.equal: binder names included) after renaming.
Exit 0 = SAME-MODULO-PRIVATE-RENAMING, 1 = different, 2 = usage.
-/
import Lean
open Lean

def kindOf : ConstantInfo → String
  | .axiomInfo _ => "axiom" | .defnInfo _ => "def" | .thmInfo _ => "thm" | .opaqueInfo _ => "opaque"
  | .quotInfo _ => "quot" | .inductInfo _ => "induct" | .ctorInfo _ => "ctor" | .recInfo _ => "rec"

def valOf? : ConstantInfo → Option Expr
  | .defnInfo v => some v.value | .thmInfo v => some v.value | .opaqueInfo v => some v.value | _ => none

def renameName (mods : List Name) (kept : Name) (n : Name) : Name :=
  match privatePrefix? n with
  | some p =>
    if mods.any (fun m => p == Name.mkNum (privateHeader ++ m) 0) then
      Name.mkNum (privateHeader ++ kept) 0 ++ privateToUserName n
    else n
  | none => n

partial def renameExpr (f : Name → Name) (e : Expr) : Expr :=
  e.replace fun
    | .const n ls => some (.const (f n) ls)
    | .proj s i b => some (.proj (f s) i (renameExpr f b))
    | _ => none

/-- auxiliary constants generated by the elaborator (abstracted proofs, matchers, equation lemmas, ...) -/
def isAuxName (n : Name) : Bool :=
  n.components.any fun c => match c with
    | .str _ s => s.startsWith "_proof_" || s.startsWith "match_" || s.startsWith "eq_" || s.startsWith "_auxLemma" ||
                  s.startsWith "proof_" || s == "_unary" || s == "_mutual" || s.startsWith "_simp_" || s.startsWith "_cstage"
    | _ => false

partial def parsePairs : List String → List (String × String)
  | a :: b :: rest => (a, b) :: parsePairs rest
  | _ => []

def main (args : List String) : IO UInt32 := do
  match args with
  | merged :: kept :: rest =>
    let pairs := parsePairs rest
    if pairs.isEmpty then IO.eprintln "usage"; return 2
    let keptN := kept.toName
    let mods := pairs.map (·.2.toName)
    let f := renameName mods keptN
    let (mm, _) ← readModuleData merged
    let mut orig : Std.HashMap Name ConstantInfo := {}
    let mut origOrder : Array Name := #[]
    for (file, _) in pairs do
      let (md, _) ← readModuleData file
      for c in md.constants do
        let n := f c.name
        orig := orig.insert n c
        origOrder := origOrder.push n
    let mut ndiff := 0
    let mut nalpha := 0
    let mut nstmt := 0   -- differing constants whose TYPE is not alpha-equal (statement change)
    let mut nuserstmt := 0
    let mut nmissing := 0
    let mergedNames : Std.HashSet Name := mm.constNames.foldl (·.insert ·) {}
    for n in origOrder do
      if !mergedNames.contains n then
        nmissing := nmissing + 1
        if nmissing ≤ 10 then IO.println s!"  missing in merged: {n}"
    let mut nextra := 0
    for c in mm.constants do
      match orig[c.name]? with
      | none =>
        nextra := nextra + 1
        if nextra ≤ 10 then IO.println s!"  extra in merged: {c.name}"
      | some o =>
        let same := kindOf c == kindOf o && c.levelParams == o.levelParams &&
          c.type.equal (renameExpr f o.type) &&
          (match valOf? c, valOf? o with
           | some x, some y => x.equal (renameExpr f y)
           | none, none => true
           | _, _ => false)
        let alpha := kindOf c == kindOf o && c.levelParams == o.levelParams &&
          c.type == renameExpr f o.type &&
          (match valOf? c, valOf? o with
           | some x, some y => x == renameExpr f y
           | none, none => true
           | _, _ => false)
        if !same && alpha then nalpha := nalpha + 1
        if !alpha then
          ndiff := ndiff + 1
          if !(c.type == renameExpr f o.type) then
            nstmt := nstmt + 1
            if !isAuxName c.name then nuserstmt := nuserstmt + 1
          if ndiff ≤ 10 then IO.println s!"  constant differs: {c.name} ({kindOf c}) type={c.type.equal (renameExpr f o.type)}"
    let nren := origOrder.foldl (fun k n => if isPrivateName n then k + 1 else k) 0
    IO.println s!"merged constants {mm.constants.size}, originals {origOrder.size} (private {nren}), missing {nmissing}, extra {nextra}, alpha-equal-only {nalpha}, differing {ndiff} (statement differs {nstmt}, of user constants {nuserstmt}); missing/extra aux only: {(origOrder.filter (fun n => !mergedNames.contains n)).all isAuxName && (mm.constants.filter (fun c => !orig.contains c.name)).all (fun c => isAuxName c.name)}"
    if nmissing == 0 && nextra == 0 && ndiff == 0 then
      if nalpha == 0 then IO.println "SAME-MODULO-PRIVATE-RENAMING" else IO.println "ALPHA-EQUAL-MODULO-PRIVATE-RENAMING"
      return 0
    else
      IO.println "DIFFERENT"; return 1
  | _ => IO.eprintln "usage: OleanMergeDiff MERGED.olean KEPT ORIG1.olean MOD1 ..."; return 2
