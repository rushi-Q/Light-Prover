
/- P2MHide (appended to P2M/Util.lean by attrhide.py).
The AI-FLT files pin their elaboration context with explicit erasure lists `attribute [-instance] a b ...` /
`attribute [-simp] a b ...` (362 MB = 32 % of the source). Hypothesis: every list is GENERATED by one rule -
erase every simp lemma / instance that is declared in a PROJECT module (Definitions.*, P2M.*, Theorems.*) and that is
visible now but not visible from the file's own non-alias imports (the modules given as arguments).
* `p2m_hide_check kind (M1 M2 ...) n1 n2 ...` (kind = `inst` or `simp`) : computes that rule set R, compares it with the explicit list L,
  writes `<module> <kind> |L| |R| |L-R| |R-L| ...` to `.lake/p2m_hide/<module>.<kind>` (cwd = package root during the
  build), then erases exactly L (= the original `attribute [-kind] n1 n2 ...`).
* `p2m_hide kind (M1 M2 ...)` : erases R minus `generatorSkips` (the compressed form, used only where the check build
  found L = R minus generatorSkips for that file and kind).
Erasing is `Attribute.erase`, exactly what the `attribute [-kind]` command does for each name. -/
namespace P2MHide
open Lean Elab Command Meta

def isProj (m : Name) : Bool :=
  (`Definitions).isPrefixOf m || (`P2M).isPrefixOf m || (`Theorems).isPrefixOf m

def closureOf (env : Environment) (roots : Array Name) : NameHashSet := Id.run do
  let mut seen : NameHashSet := {}
  let mut stack : Array Name := roots
  while !stack.isEmpty do
    let m := stack.back!
    stack := stack.pop
    if seen.contains m then continue
    seen := seen.insert m
    if let some i := env.getModuleIdx? m then
      for imp in env.header.moduleData[i.toNat]!.imports do
        unless seen.contains imp.module do stack := stack.push imp.module
  return seen

def modOf (env : Environment) (n : Name) : Option Name :=
  (env.getModuleIdxFor? n).map fun i => env.header.moduleNames[i.toNat]!

/-- generated declarations the AI-FLT generator never lists (measured on the check build): `*._sizeOf_inst` instances and
the `injEq` / `sizeOf_spec` simp lemmas of structures declared inside the proof namespaces `P2MW.*` -/
def generatorSkips (n : Name) : Bool :=
  match n with
  | .str _ s => s == "_sizeOf_inst" || ((`P2MW).isPrefixOf n && (s == "injEq" || s == "sizeOf_spec"))
  | _ => false

def ruleSet (env : Environment) (kind : Name) (vis : NameHashSet) (refined := false) : NameHashSet := Id.run do
  -- private names of other modules cannot be named in an `attribute` command: never part of a generated list
  let keep0 (n : Name) : Bool := match modOf env n with
    | some m => isProj m && !vis.contains m && !isPrivateName n
    | none => env.contains n && !isPrivateName n   -- declared earlier in THIS file (alias-collapsed trees: the inlined proof's helpers)
  let keep (n : Name) : Bool := keep0 n && !(refined && generatorSkips n)
  let mut out : NameHashSet := {}
  if kind == `simp then
    let s := simpExtension.getState env
    out := s.lemmaNames.fold (init := out) fun acc o => match o with
      | .decl n _ _ => if keep n then acc.insert n else acc
      | _ => acc
    out := s.toUnfold.fold (init := out) fun acc n => if keep n then acc.insert n else acc
  else
    let s := Meta.instanceExtension.getState env
    out := s.instanceNames.foldl (init := out) fun acc n _ => if keep n then acc.insert n else acc
  return out

def sortNames (s : NameHashSet) : Array Name :=
  s.toArray.qsort (fun a b => Name.cmp a b == .lt)

syntax (name := hideCheck) "p2m_hide_check " ident " (" ident* ")" ident* : command
syntax (name := hide) "p2m_hide " ident " (" ident* ")" : command

/-- `inst` -> the `instance` attribute (keyword), `simp` -> `simp` -/
def attrOf (k : Name) : Name := if k == `inst then `instance else k

@[command_elab hideCheck] def elabHideCheck : CommandElab := fun stx => do
  let kind := attrOf stx[1].getId
  let vis := closureOf (← getEnv) (stx[3].getArgs.map (·.getId))
  let mut L : NameHashSet := {}
  for id in stx[5].getArgs do
    let n ← liftCoreM do
      let ns ← realizeGlobalConstWithInfos id
      ensureNonAmbiguous id ns
    L := L.insert n
  let env ← getEnv
  let R := ruleSet env kind vis
  let lr := (sortNames L).filter (!R.contains ·)
  let rl := (sortNames R).filter (!L.contains ·)
  let line := s!"{env.mainModule} {kind} L={L.size} R={R.size} LmR={lr.size} RmL={rl.size}\nLmR {lr.toList}\nRmL {rl.toList}\n"
  try
    IO.FS.createDirAll ".lake/p2m_hide"
    IO.FS.writeFile s!".lake/p2m_hide/{env.mainModule}.{kind}" line
  catch _ => pure ()
  for n in sortNames L do
    liftCoreM <| Attribute.erase n kind

@[command_elab hide] def elabHide : CommandElab := fun stx => do
  let kind := attrOf stx[1].getId
  let vis := closureOf (← getEnv) (stx[3].getArgs.map (·.getId))
  for n in sortNames (ruleSet (← getEnv) kind vis (refined := true)) do
    liftCoreM <| Attribute.erase n kind

end P2MHide
