# pins of the sound check (check-sound.sh). Lines: PIN <name> <sha256> <absolute path>. Paths are node-local (/scratch);
# copy the files there on a new machine (tools/deploy.sh). The sha256 values are enforced on every run.
SOUND_VERSION=sound-v1-portable (three-leg sound check for Lean 4.36.0: ccmp 4e82fe00 = the comparison leg (the official v4.36.0 lake comparator judge code: statements and axioms); pleanchecker 53957eed = parallel Lean.Replay linked against PGO+ThinLTO builds of the official v4.36.0 kernel sources (manylinux_2_28, static libstdc++, GLIBC_2.17) + the veto-only post-replay export-record check + the loose-bvar check (Lean #16489/#15100/#15101) + kernel-generated constants only for inductive blocks (no export record of an inductive block enters an environment the kernel reads; unlearned blocks checked synchronously); gruszka ece04e74 = the independent second kernel (portable reproducible build, tools/reproduce/portable-gruszka.sh); pleanchecker_incr 6a909238 = the incremental / targeted variant of pleanchecker with the same checks and libraries (opt-in overlap); snapshot_exporter 4ac1016d (opt-in overlap); con_leche 8fff3f05 and nanoda 5c34d612 = optional veto-only extra kernels bundled with the official v4.37.0-rc1 release; details: check/sound/README.md)
TC36=@components
PIN ccmp 4e82fe00f73f96c54471475d4def2d8bfafc239b9694557faffa70179b6b216d /scratch/fastverify-next/sound/4e82fe00/ccmp
PIN pleanchecker 53957eed5fda7baa728708b87ed85508dd5e4fe9f3c99318bda0451451fbc65a /scratch/fastverify-next/sound/53957eed/pleanchecker
PIN gruszka ece04e7458efafd34e71330e982bf3b46904d48ff5f1089c7094844c9562fe58 /scratch/fastverify-next/gruszka/ece04e74/gruszka
PIN selftest_comparator 9c77b8d2c3c5fb92a8681e5f9d9d9bde0a8ff0fe35ecc5a31ac3024ff4f12802 /scratch/fastverify-next/selftest/comparator.json
PIN selftest_challenge f83cfdd3029814bd61d88e808b2c2e33344ca893214cfec0faa15c66c1048af0 /scratch/fastverify-next/selftest/challenge.export
PIN selftest_good cbc6a26ce8c2c9b4e97085d6822c33026eb36e15ba24a5be0ec8f25746e4d281 /scratch/fastverify-next/selftest/good.export
PIN selftest_bad a48f2d1c4c8e6d5b4be291f72a64926c9afa8398508e02fb68cec2df73a0513f /scratch/fastverify-next/selftest/bad.export
PIN pleanchecker_incr 6a9092380325cc6f6ae94234e671aa67ba6a5daf163e642611d01c0762b91b7f /scratch/fastverify-next/sound/6a909238/pleanchecker-targeted
PIN snapshot_exporter 4ac1016d928ccec86869d392ab6f3485fa139bd361ba484154f80126af4bd9cd /scratch/fastverify-next/overlap/4ac1016d/lean4export-snap
# v2.3-H: extra VETO-ONLY kernels of check-sound(-svc).sh = the binaries BUNDLED with the official
# Lean v4.37.0-rc1 release (toolchains/leanprover--lean4---v4.37.0-rc1.json bin/con-leche, bin/nanoda_bin; release archive
# sha256 2e1bbb83..., commit 0b77e129), copied unchanged; selftest_kbad = selftest_good with the proof of fvSelfTest made
# ill-typed (check/sound/test/run.sh's kernel-bad mutant). Optional lines: without them the judge is v2.2's two-kernel judge.
PIN con_leche 8fff3f055d032b66d5262cb6db4fb916328b4931a98634630f7481b1e3449308 /scratch/fastverify-next/extra-kernels/8fff3f05/con-leche
PIN nanoda 5c34d6124b19dfd23c7d0377b520893cf8adec5c23fa0c809dde9e38eb201ffe /scratch/fastverify-next/extra-kernels/5c34d612/nanoda_bin
