+/// D11 low-mem: `pack_file` also returning MAIN segment starts for `read::decode_par`
+/// without holding the packed `.susz` bytes in heap RAM.
+pub fn pack_file_segs(input: &str, output: &str, opts: &Options) -> R<(Stats, Vec<crate::read::SegStart>)> {
+    tmark("start");
+    let (pk, parallel) = read(input, opts)?;
+    tmark("read");
+    let mut segs = Vec::new();
+    let mut st = write_file_segs(pk, output, opts, Some(&mut segs))?;
+    st.parallel = parallel;
+    Ok((st, segs))
+}
