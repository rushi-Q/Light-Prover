# prechk binary location (node-local, identical on every host; deployed by tools/deploy.sh from the build host).
# Versioned, immutable file name: package snapshots keep finding the binary they pin even after a newer version is installed.
# Rebuild: check/prechk/build.sh --install (installs prechk-<version>-<sha9> + updates this file and SHA256SUMS)
PRECHK_BIN=/scratch/fastverify-next/prechk/prechk-1.6-c7ea95ca9
