+/// gruszka Y3-1: set when a parsed `letE` record has `"nondep":true`. The packed format carries no nondep (every let is
+/// written as tag 13), so a consumer that compares expressions as Lean's `==` does (which compares nondep) learns here
+/// whether two lets that look equal in the packed form may differ in the export. Set by both parsers (lines.rs fast path,
+/// pk.rs JSON path) on any thread; never cleared within a process.
+pub static ANY_NONDEP_LET: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+/// Whether a `letE` record with `"nondep":true` was packed in this process (see `ANY_NONDEP_LET`).
+pub fn saw_nondep_let() -> bool {
+    ANY_NONDEP_LET.load(std::sync::atomic::Ordering::SeqCst)
+}
