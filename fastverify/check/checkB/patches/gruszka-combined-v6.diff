+                    continue;
+                }
+                match self.tk(t) {
+                    LET => return Ok(true),
+                    BVAR => {
+                        let i = self.tp(t);
+                        if i >= depth {
+                            todo_v.push(self.env_get(e, i - depth)?);
+                        }
+                    }
+                    APP => {
+                        todo_t.push((self.ta(t), e, depth));
