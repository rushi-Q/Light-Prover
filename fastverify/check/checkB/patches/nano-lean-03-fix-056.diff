+    /// F06 fix-056: the inductive a projection may project from, as Lean 4.36 `infer_proj` allows it: exactly one
+    /// constructor, indices allowed (the type's arguments are then the parameters followed by the indices).
+    fn proj_ctor(&self, n: NamePtr<'t>) -> Option<(Inductive<'t>, Constructor<'t>)> {
+        let Some(Declar::Ind(i)) = self.declar(n) else {
+            return None;
+        };
+        if i.ctors.len() != 1 {
+            return None;
+        }
+        Some((i, self.ctor(i.ctors[0])?))
+    }
