+    // DataValue (deriving BEq): ofString 0, ofBool 1, ofName 2, ofNat 3, ofInt 4; ofSyntax 5 is never matched
+    bool dval(uint32_t ma, uint64_t a, uint32_t mb, uint64_t b) {
