+        uint8_t t = tag(pa);
+        if (t != tag(pb) || nobjs(pa) != nobjs(pb)) { why = "level tag"; return false; }
+        if (sc_u64(pa, 0) != sc_u64(pb, 0)) { why = "level data"; return false; }  // cached Level.Data
+        switch (t) {
+            case 0: return nobjs(pa) == 0;
